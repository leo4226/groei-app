DATABASE_URL=postgresql://floreren:dev@localhost:5432/floreren
JWT_SECRET=dev-secret-change-me
# Uploaded images: Cloudflare R2 by default (STORAGE_BACKEND unset or "r2").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floreren-uploads
R2_PUBLIC_BASE_URL=
# Self-hosting: keep files on local disk instead, served by the backend at the
# path of LOCAL_STORAGE_PUBLIC_BASE_URL (must have one, e.g. /media).
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=/data/uploads
# LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:1415/media
RESEND_API_KEY=
PLANTNET_API_KEY=
TREFLE_TOKEN=
# LLM provider — Nous Portal (OpenAI-compatible). DeepSeek V4 Flash by default.
NOUS_API_KEY=
# Optional overrides:
# LLM_CHAT_URL=https://inference-api.nousresearch.com/v1/chat/completions
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_FUN_FACT_MODEL=deepseek/deepseek-v4-flash-0731
